# Virtual Butler — Environment Configuration
# See README.md for full setup instructions.

# Backend configuration
JARVIS_BACKEND=http://127.0.0.1:5000

# Zen API (free brain — no OpenAI key needed)
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MODEL=big-pickle

# Optional: OpenAI key for cloud fallback
# OPENAI_API_KEY=sk-...

# Logging verbosity
# 0 = silent, 1 = normal (default), 2 = debug
BUTLER_VERBOSE=1

# Server configuration
PORT=5000
HOST=127.0.0.1