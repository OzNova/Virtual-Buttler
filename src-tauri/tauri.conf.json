{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Butler",
  "version": "0.1.0",
  "identifier": "com.butler.hud",
  "build": {
    "frontendDist": "../hud/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix ../hud run dev",
    "beforeBuildCommand": "npm --prefix ../hud run build"
  },
  "app": {
    "windows": [
      {
        "title": "Butler",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "trayIcon": {
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
      "tooltip": "Butler (local-only)"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "global-shortcut": {
      "shortcuts": ["CommandOrControl+Shift+Space"]
    }
  }
}
