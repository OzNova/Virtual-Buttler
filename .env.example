# Copy to .env (git-ignored). All optional — sane defaults apply.
# GEMINI_API_KEY=YOUR_KEY
# GEMINI_MODEL=gemini-2.0-flash
# OLLAMA_BASE=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b
# OLLAMA_TIMEOUT=30
# TTS_VOICE=Daniel
# JARVIS_BACKEND=http://127.0.0.1:5000
# PORT=5000
# --- Phase 3 voice (all optional) ---
# BUTLER_TTS=say  # say|elevenlabs|openai
# BUTLER_STT=off  # off|groq|deepgram
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# DEEPGRAM_API_KEY=
# BUTLER_DUCKING=1
# BUTLER_DUCK_LEVEL=25
# --- Phase 4 knowledge/vision/calendar/home (all optional) ---
# BUTLER_DOC_PATHS=~/Documents  # colon-separated allowlist (empty = disabled)
# BUTLER_DOC_INDEX=data/docs.jsonl
# BUTLER_VECTOR=
# BUTLER_ICS_PATHS=
# BUTLER_FOCUS_WINDOW_MIN=30
# HASS_URL=
# HASS_TOKEN=
